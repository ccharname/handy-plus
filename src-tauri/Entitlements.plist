<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- MLX Metal JIT shader compilation (mlx-audio-swift bridge).
         Apple recommends `cs.allow-jit` for modern JIT under hardened runtime
         (macOS 11+); `cs.allow-unsigned-executable-memory` is the legacy
         broader form kept as belt-and-suspenders. Without these the kernel
         SIGKILLs the process when MLX maps RWX pages for shader code and
         no crash log is produced. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- mlx-audio-swift loads SPM-bundled dylibs (mlx-swift, swift-transformers,
         tokenizers, etc.). Library validation under hardened runtime blocks
         dlopen of dylibs whose codesigning team ID doesn't match ours
         (our self-signed identity vs upstream package adhoc signatures). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>